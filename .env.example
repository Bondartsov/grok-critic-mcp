# === grok-critic-mcp configuration ===
# Все переменные имеют префикс POLZA_ (pydantic-settings env_prefix)

# API ключ Polza.AI (обязательно)
POLZA_API_KEY=your-api-key-here

# Base URL Polza.AI API
POLZA_BASE_URL=https://polza.ai/api/v1

# Модель grok
POLZA_MODEL=x-ai/grok-4.20-multi-agent

# Количество агентов (4=быстро, 16=глубоко)
POLZA_AGENT_COUNT=16

# Timeout запроса в секундах
POLZA_TIMEOUT_SECONDS=300

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
POLZA_LOG_LEVEL=WARNING

# Куда пишутся логи (пусто = stderr)
POLZA_LOG_FILE=

# Стоимость за 1 миллион токенов (USD). 0 = не рассчитывать.
POLZA_PRICE_INPUT_PER_1M=2.6
POLZA_PRICE_OUTPUT_PER_1M=6.6

# === Безопасность ===

# Чтение файлов через file_path (SEC-03). По умолчанию ВЫКЛЮЧЕНО:
# cwd MCP-клиента непредсказуем (часто это $HOME).
POLZA_ALLOW_FILE_PATH=false

# Доп. директории для file_path (разделитель ';' на Windows, ':' на Unix).
# Действует только при POLZA_ALLOW_FILE_PATH=true.
POLZA_ALLOWED_READ_DIRS=

# === Надёжность и бюджет ===

# Общий дедлайн retry-цикла, сек (REL-06). 0 = авто (= POLZA_TIMEOUT_SECONDS):
# суммарное время попыток не превысит таймаут MCP-клиента.
POLZA_RETRY_DEADLINE_SECONDS=0

# Дневной лимит расходов в USD (по расчётной стоимости). 0 = без лимита.
# Превышение -> ошибка ДО обращения к платному API.
POLZA_DAILY_BUDGET_USD=0

# Максимум одновременных платных запросов к API.
POLZA_MAX_CONCURRENT_REQUESTS=2

# Разрешить self_update (git pull + pip install + рестарт). Требует установки
# из git-клона (pip install -e .). По умолчанию выключен.
POLZA_ALLOW_SELF_UPDATE=false

# Явный путь к .env (опционально). По умолчанию: cwd/.env, затем рядом с пакетом.
# POLZA_ENV_FILE=/path/to/.env
